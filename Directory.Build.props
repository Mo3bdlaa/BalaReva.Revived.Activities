<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Lets the Windows-targeted projects build on a Linux CI agent. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Shared package metadata. Individual activity packages set their own Id,
       version and description. -->
  <PropertyGroup>
    <Authors>Mohamed Shaker</Authors>
    <Company>BalaReva.Revived</Company>
    <PackageProjectUrl>https://github.com/Mo3bdlaa/BalaReva.Revived.Activities</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Mo3bdlaa/BalaReva.Revived.Activities</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>UiPath;RPA;Activities;BalaReva</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
