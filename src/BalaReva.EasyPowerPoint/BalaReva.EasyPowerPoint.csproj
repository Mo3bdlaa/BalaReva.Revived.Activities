<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- COM, for the same reason as Word and Excel: Print, PasteClipboard,
         ChartCopyToClipboard, ExecuteMacro, ExportPdf, SaveAs across 39 PowerPoint
         formats, RefreshData and UpdateLinks all need PowerPoint running. Driven
         late-bound rather than through an interop assembly; see the note below. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>BalaReva.EasyPowerPoint</RootNamespace>
    <AssemblyName>BalaReva.Easy.PowerPoint</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BalaReva.Revived.EasyPowerPoint.Activities</PackageId>
    <Version>1.0.0</Version>
    <Title>BalaReva Revived - Easy PowerPoint Activities</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>
      PowerPoint activities for UiPath, reimplemented on .NET 8. Type and property names
      match BalaReva.EasyPowerPoint.Activities 11.0.0 so existing workflows keep binding.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UiPath.Workflow.Runtime" Version="6.0.3" />
    <!-- No PowerPoint interop package, and the reason is worth keeping: referencing
         one compiles, but every Office interop assembly on NuGet has a hard reference
         on 'office' (Microsoft.Office.Core), which Microsoft does not publish anywhere.
         The CLR resolves it the moment a Presentation-typed member is loaded, so the
         package builds and then fails at run time with a FileNotFoundException. Driving
         PowerPoint late-bound through its ProgID avoids the assembly entirely.
         See src/BalaReva.EasyPowerPoint/README.md. -->
  </ItemGroup>

</Project>
