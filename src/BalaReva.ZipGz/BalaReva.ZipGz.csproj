<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net8.0: nothing here touches Windows. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BalaReva.ZipGz</RootNamespace>
    <AssemblyName>BalaReva.ZipGz</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BalaReva.Revived.ZipUnzipGz.Activities</PackageId>
    <Version>1.0.0</Version>
    <Title>BalaReva Revived - Gzip Unzip Activities</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>
      Tar and gzip extraction for UiPath, reimplemented on .NET 8. Type and property names
      match BalaReva.ZipUnzipGz.Activities 2.0.0 so existing workflows keep binding, and
      the extraction path traversal the old dependency was vulnerable to is defended
      directly rather than being left to the library.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- One copy of the path check, shared with the zip package. -->
    <Compile Include="../Shared/SafeExtractPath.cs" Link="SafeExtractPath.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UiPath.Workflow.Runtime" Version="6.0.3" />
    <!-- Was 1.2.0, which carried CVE-2021-32840 and CVE-2021-32842, both path traversal
         on extraction. Fixed in 1.3.3; this is 1.4.2. The published package also vendored
         a copy of the assembly in lib/ alongside the dependency, which this does not. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

</Project>
