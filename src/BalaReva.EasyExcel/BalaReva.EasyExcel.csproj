<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- COM, for the same reasons as Word and Excel, and with less room to argue:
         ExcelScope holds a live Workbook that it hands to its body, and SetBorder
         binds an XlLineStyle, so the interop types are in the published binding
         surface rather than merely under it. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>BalaReva.EasyExcel</RootNamespace>
    <AssemblyName>BalaReva.EasyExcel</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BalaReva.Revived.EasyExcel.Activities</PackageId>
    <Version>1.0.0</Version>
    <Title>BalaReva Revived - Easy Excel Activities</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>
      Excel activities for UiPath, reimplemented on .NET 8. Type and property names match
      BalaReva.EasyExcel.Activities 32.0.0 so existing workflows keep binding.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UiPath.Workflow.Runtime" Version="6.0.3" />
    <!-- Declared, not vendored, unlike the published package. -->
    <PackageReference Include="Microsoft.Office.Interop.Excel" Version="16.0.18925.20022" />
    <!-- GetHiddenRows and GetHiddenColumns read the file without opening Excel, which
         is what BaseOpenXml is for. The published package pinned 2.20.0. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

</Project>
