<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net8.0: Npgsql is managed and cross-platform, so these activities work in
         a Studio Cross-platform project, which the original could not. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BalaReva.PostgreSQL</RootNamespace>
    <AssemblyName>BalaReva.PostgreSql.Activities</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BalaReva.Revived.PostgreSql.Activities</PackageId>
    <Version>1.0.0</Version>
    <Title>BalaReva Revived - PostgreSQL Activities</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>
      PostgreSQL activities for UiPath, reimplemented on .NET 8. Type and property names
      match BalaReva.PostgreSql.Activities 2021.0.0 so existing workflows keep binding.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UiPath.Workflow.Runtime" Version="6.0.3" />
    <!-- Was 4.0.7, inside the affected range for CVE-2024-32655 (SQL injection through a
         protocol message size overflow), fixed in 4.0.14. This is the current 10.0.3,
         which still carries a net8.0 asset. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
