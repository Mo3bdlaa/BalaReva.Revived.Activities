<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The published package shipped net461 + net6.0-windows. Nothing in these
         activities touches Windows: they read and write text files. Targeting
         plain net8.0 keeps them usable from a Studio Windows project and makes
         them work in a Cross-platform project too, which the original could not. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BalaReva.EasyText</RootNamespace>
    <AssemblyName>BalaReva.EasyText</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BalaReva.Revived.EasyText.Activities</PackageId>
    <Version>1.0.0</Version>
    <Title>BalaReva Revived - Easy Text Activities</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>
      Text file activities for UiPath, reimplemented on .NET 8. Type and property
      names match BalaReva.EasyText.Activities 3.0.1 so existing workflows keep
      binding.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- UiPath's CoreWF port: this is System.Activities for .NET 6 and later. -->
    <PackageReference Include="UiPath.Workflow.Runtime" Version="6.0.3" />
  </ItemGroup>

</Project>
