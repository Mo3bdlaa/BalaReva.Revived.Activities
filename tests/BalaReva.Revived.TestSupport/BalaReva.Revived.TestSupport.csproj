<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- A helper library, not a test assembly. Referencing xunit is otherwise enough
         for a solution-wide `dotnet test` to try running it, which aborts the run
         because it has no test host. -->
    <IsTestProject>false</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>BalaReva.Revived.TestSupport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The recorded surface of the published packages, produced by tools/ApiSurface. -->
    <Content Include="../../audit/data/api-surface.json" Link="api-surface.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
