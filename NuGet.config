<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- UiPath.Workflow (the CoreWF port that provides System.Activities on .NET 6+)
         lives on nuget.org. The official feed is here for UiPath.Activities.Api and
         friends, should design-time projects need them later. -->
    <add key="uipath-official" value="https://pkgs.dev.azure.com/uipath/Public.Feeds/_packaging/UiPath-Official/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
